# r2xsql: core tables over a real compiled binary.
# Each CMDS block ends in a `sql,:quiet` whose SQL evaluates the assertion, so
# EXPECT is a literal 1 rather than a compiler-dependent count.

NAME=funcs is non-empty after analysis
FILE=build/fixture.bin
ARGS=-N
CMDS=<<EOF
aaa
"sql,:quiet SELECT count(*) > 0 FROM funcs"
EOF
EXPECT=<<EOF
1
EOF
RUN

NAME=funcs contains a function named main
FILE=build/fixture.bin
ARGS=-N
CMDS=<<EOF
aaa
"sql,:quiet SELECT count(*) > 0 FROM funcs WHERE name LIKE '%main%'"
EOF
EXPECT=<<EOF
1
EOF
RUN

NAME=strings carries the fixture marker
FILE=build/fixture.bin
ARGS=-N
CMDS=<<EOF
aaa
"sql,:quiet SELECT count(*) > 0 FROM strings WHERE content LIKE '%r2xsql_test_marker_string%'"
EOF
EXPECT=<<EOF
1
EOF
RUN

