# libxsql -- r2xsql's SQL core (SQLite virtual-table framework + vendored
# sqlite3/nlohmann/httplib). It ships no meson.build of its own (CMake-native),
# so the packagefiles/ overlay below supplies one for the meson build path.
#
# When developing against a local libxsql, prefer that checkout over this fetch:
# drop it in as subprojects/libxsql/ and meson will use the present directory in
# preference to the wrap. Otherwise this fetches the same source CMake does.
[wrap-git]
url = https://github.com/0xeb/libxsql.git
revision = main
depth = 1
patch_directory = libxsql

[provide]
libxsql = xsql_dep
